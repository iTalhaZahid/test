# Local development only. Do not reuse these credentials outside your machine.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_local_only
POSTGRES_DB=pos
# Required for local Docker demos. Generate once and preserve it:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POS_WEB_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
# Required when packaging the standalone desktop; public HTTPS origin, no /api suffix.
# POS_API_URL=https://your-deployed-pos-origin
