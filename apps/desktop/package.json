{
  "name": "@pos/desktop",
  "version": "0.1.0",
  "description": "POS v1 Windows terminal",
  "author": "POS",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "test": "tsc -p tsconfig.main.json && node scripts/test-main.mjs && node --test scripts/report-chart-data.test.mjs scripts/report-export.test.mjs scripts/sales-receipt.test.mjs scripts/catalog-cache.test.mjs scripts/sync-status.test.mjs",
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:demo": "pnpm build && electron-builder --config electron-builder.demo.yml --win nsis --x64 --publish never",
    "package:standalone": "corepack pnpm build && node scripts/package-standalone.mjs",
    "package:online": "corepack pnpm build && node scripts/package-standalone.mjs --online",
    "package:latest": "corepack pnpm build && node scripts/package-standalone.mjs --latest"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@pos/shared": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6"
  }
}