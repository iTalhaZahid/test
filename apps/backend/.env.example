# Optional: set PORT in your shell; defaults to 4000.
PORT=4000
# Set these in the process environment; the app does not load .env automatically.
POS_DATA_DIR=.data

# Web API database directory; defaults to POS_DATA_DIR/web.
# To preserve existing web records, set this to the old admin-web .data directory
# (absolute path), or copy that entire directory including protection.key.
# POS_WEB_DATA_DIR=/var/lib/pos/web
# Private demonstrations only: enables the existing web demo accounts.
# POS_WEB_DEMO=1
