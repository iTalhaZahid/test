# Set these in Vercel's environment settings. Never commit real values.
# Neon CLI writes actual URLs to the repository root .env.local (or .env).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=verify-full
# Used only by npm run db:migrate; do not use a pooled hostname here.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Preserve this secret across redeployments. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POS_WEB_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
# Private demo accounts only; not suitable for a public production service.
POS_WEB_DEMO=1
# Optional local API port; defaults to 4000.
PORT=4000
