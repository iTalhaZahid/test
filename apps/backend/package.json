{
  "name": "@pos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.mts",
    "build": "tsc -p tsconfig.build.json --noEmit && esbuild src/server.mts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/app.test.ts src/models/web-store.test.ts scripts/sync.integration.test.mjs"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@pos/shared": "workspace:*",
    "@types/express": "5.0.6",
    "tsx": "4.23.15",
    "esbuild": "0.28.2"
  }
}
