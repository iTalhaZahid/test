{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-web": {
      "root": "apps/admin-web",
      "framework": "nextjs",
      "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 corepack pnpm install --frozen-lockfile",
      "buildCommand": "corepack pnpm build",
      "outputDirectory": ".next",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "apps/backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 corepack pnpm install --frozen-lockfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin-web"
      }
    }
  ]
}
